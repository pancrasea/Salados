[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/end_of_day.gd" id="1_script"]

[node name="EndOfDay" type="CanvasLayer"]
layer = 20
script = ExtResource("1_script")

[node name="Fondo" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="Centro" type="CenterContainer" parent="Fondo"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Fondo/Centro"]
custom_minimum_size = Vector2(520, 0)

[node name="Margin" type="MarginContainer" parent="Fondo/Centro/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Fondo/Centro/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Titulo" type="Label" parent="Fondo/Centro/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "Día terminado"
horizontal_alignment = 1

[node name="Resumen" type="Label" parent="Fondo/Centro/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Ganado hoy: $0"
horizontal_alignment = 1

[node name="Boton" type="Button" parent="Fondo/Centro/Panel/Margin/VBox"]
layout_mode = 2
text = "Volver al menú"
